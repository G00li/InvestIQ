generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  name       String?
  email      String      @unique
  investments Investment[]
  createdAt  DateTime    @default(now())
  github     String?
  birthDate  DateTime?
  avatar     String?
  updatedAt  DateTime    @updatedAt

}

model Investment {
  id         String   @id @default(uuid())
  name       String
  amount     Float
  category   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
}
