FROM python:3.11-slim

WORKDIR /app

# Dependências do sistema incluindo Ollama
RUN apt-get update && \
    apt-get install -y gcc libffi-dev libpq-dev curl && \
    curl -fsSL https://ollama.com/install.sh | sh && \
    rm -rf /var/lib/apt/lists/*

# Instala as dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o restante da aplicação
COPY . .

# Adiciona o diretório app ao PYTHONPATH
ENV PYTHONPATH=/app

# Expor as portas do FastAPI e Ollama
EXPOSE 8000 11434

# Script de inicialização para rodar tanto o Ollama quanto o FastAPI
RUN echo '#!/bin/bash\n\
ollama serve &\n\
sleep 5\n\
ollama pull orca-mini\n\
uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload' > /start.sh && \
    chmod +x /start.sh

CMD ["/start.sh"]
